con svg,\r\n  .contact-hero__feature-icon svg {\r\n    width: 13px !important;\r\n    height: 13px !important;\r\n  }\r\n\r\n  .about-hero__feature-text,\r\n  .colleges-hero__feature-text,\r\n  .services-hero__feature-text,\r\n  .gallery-hero__feature-text,\r\n  .contact-hero__feature-text {\r\n    font-size: clamp(0.58rem, 2.1vw, 0.72rem) !important;\r\n    line-height: 1.2 !important;\r\n    font-weight: 600 !important;\r\n    white-space: normal !important;\r\n    word-break: normal !important;\r\n    overflow-wrap: break-word !important;\r\n    text-align: left !important;\r\n  }\r\n\r\n  .about-hero__feature-divider,\r\n  .colleges-hero__feature-divider,\r\n  .services-hero__feature-divider,\r\n  .gallery-hero__feature-divider,\r\n  .contact-hero__feature-divider {\r\n    height: 20px !important;\r\n    margin: 0 0.1rem !important;\r\n    opacity: 0.35 !important;\r\n    flex-shrink: 0 !important;\r\n  }\r\n\r\n  /* Footer & Safe Area Padding */\r\n  .site-footer {\r\n    padding-top: clamp(1.75rem, 5vw, 2.25rem);\r\n    padding-bottom: calc(1.5rem + env(safe-area-inset-bottom, 15px));\r\n  }\r\n\r\n  .site-footer__grid {\r\n    grid-template-columns: 1fr;\r\n    gap: 1.35rem;\r\n  }\r\n\r\n  .site-footer__contact-item,\r\n  .site-footer__contact-link {\r\n    white-space: normal;\r\n    word-break: break-word;\r\n    font-size: clamp(0.82rem, 3.2vw, 0.88rem);\r\n  }\r\n\r\n  .app-shell__main {\r\n    padding-bottom: 0;\r\n  }\r\n}\r\n\r\n/* Extra-Compact Screen Optimization (< 360px - e.g. iPhone SE, Galaxy Fold cover) */\r\n@media (max-width: 23.5rem) {\r\n  .container,\r\n  .hero__grid {\r\n    padding-left: 10px !important;\r\n    padding-right: 10px !important;\r\n  }\r\n\r\n  .stats-grid {\r\n    grid-template-columns: 1fr 1fr;\r\n    gap: 6px;\r\n  }\r\n}\r\n\r\n/* ==========================================================================\r\n   COLLEGES PAGE & 4-REGION NAVIGATION STYLES\r\n   ========================================================================== */\r\n\r\n.colleges-page {\r\n  width: 100%;\r\n  background-color: var(--color-canvas);\r\n  padding-bottom: var(--space-16);\r\n}\r\n\r\n/* 2. Colleges Sticky Navigation Bar (Two-Tier Stream + Sub-Regions) */\r\n.colleges-nav-sticky {\r\n  position: sticky;\r\n  top: 4.25rem;\r\n  z-index: 40;\r\n  background: rgba(255, 255, 255, 0.96);\r\n  backdrop-filter: blur(16px);\r\n  -webkit-backdrop-filter: blur(16px);\r\n  border-bottom: 1px solid var(--color-line);\r\n  box-shadow: 0 4px 18px -4px rgba(15, 23, 42, 0.06);\r\n  padding: 0.85rem 0;\r\n  transition: all 0.2s ease;\r\n}\r\n\r\n.colleges-nav-container {\r\n  display: flex;\r\n  flex-direction: column;\r\n  align-items: center;\r\n  gap: 0.75rem;\r\n}\r\n\r\n/* Stream Switcher (Medical vs Engineering) */\r\n.colleges-stream-wrapper {\r\n  display: flex;\r\n  width: 100%;\r\n  max-width: 100%;\r\n  box-sizing: border-box;\r\n  overflow-x: auto;\r\n  scrollbar-width: none;\r\n  -ms-overflow-style: none;\r\n  padding: 0.2rem 1rem;\r\n  scroll-behavior: smooth;\r\n  -webkit-overflow-scrolling: touch;\r\n}\r\n\r\n.colleges-stream-wrapper::-webkit-scrollbar {\r\n  display: none;\r\n}\r\n\r\n.colleges-stream-tabs {\r\n  display: inline-flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n  gap: 0.35rem;\r\n  min-width: max-content;\r\n  background: #f1f5f9;\r\n  padding: 0.35rem;\r\n  border-radius: var(--radius-pill);\r\n  border: 1px solid #e2e8f0;\r\n  margin: 0 auto;\r\n}\r\n\r\n.colleges-stream-btn {\r\n  display: inline-flex;\r\n  align-items: center;\r\n  gap: 0.6rem;\r\n  padding: 0.65rem 1.45rem;\r\n  border-radius: var(--radius-pill);\r\n  font-size: 0.95rem;\r\n  font-weight: 700;\r\n  color: #475569;\r\n  background: transparent;\r\n  border: none;\r\n  cursor: pointer;\r\n  white-space: nowrap;\r\n  transition: all 0.22s cubic-bezier(0.16, 1, 0.3, 1);\r\n}\r\n\r\n.colleges-stream-btn__icon {\r\n  color: #64748b;\r\n  transition: color 0.2s ease;\r\n}\r\n\r\n.colleges-stream-btn__count {\r\n  display: inline-flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n  min-width: 1.45rem;\r\n  height: 1.45rem;\r\n  padding: 0 0.45rem;\r\n  font-size: 0.78rem;\r\n  font-weight: 700;\r\n  border-radius: var(--radius-pill);\r\n  background: #e2e8f0;\r\n  color: #334155;\r\n  transition: all 0.2s ease;\r\n}\r\n\r\n.colleges-stream-btn:hover {\r\n  color: #0f172a;\r\n  background: rgba(255, 255, 255, 0.85);\r\n}\r\n\r\n.colleges-stream-btn:hover .colleges-stream-btn__icon {\r\n  color: var(--color-primary-600);\r\n}\r\n\r\n.colleges-stream-btn--active {\r\n  color: #ffffff !important;\r\n  background: linear-gradient(135deg, #005ce6 0%, #004ecc 100%) !important;\r\n  box-shadow: 0 4px 14px rgba(0, 92, 230, 0.32);\r\n}\r\n\r\n.colleges-stream-btn--active .colleges-stream-btn__icon {\r\n  color: #ffffff !important;\r\n}\r\n\r\n.colleges-stream-btn--active .colleges-stream-btn__count {\r\n  background: rgba(255, 255, 255, 0.25) !important;\r\n  color: #ffffff !important;\r\n}\r\n\r\n/* Secondary Sub-navigation (Tamil Nadu, Puducherry, Karnataka, Abroad) */\r\n.colleges-subnav-wrapper {\r\n  display: flex;\r\n  width: 100%;\r\n  overflow-x: auto;\r\n  scrollbar-width: none;\r\n  -ms-overflow-style: none;\r\n  padding: 0.2rem 1rem;\r\n  scroll-behavior: smooth;\r\n  animation: collegesFadeIn 0.25s ease-out;\r\n  -webkit-overflow-scrolling: touch;\r\n}\r\n\r\n.colleges-subnav-wrapper::-webkit-scrollbar {\r\n  display: none;\r\n}\r\n\r\n@keyframes collegesFadeIn {\r\n  from {\r\n    opacity: 0;\r\n    transform: translateY(-4px);\r\n  }\r\n\r\n  to {\r\n    opacity: 1;\r\n    transform: translateY(0);\r\n  }\r\n}\r\n\r\n.colleges-subnav-tabs {\r\n  display: inline-flex;\r\n  align-items: center;\r\n  background: #f8fafc;\r\n  padding: 0.25rem 0.35rem;\r\n  border-radius: var(--radius-pill);\r\n  border: 1px solid #e2e8f0;\r\n  gap: 0.3rem;\r\n  min-width: max-content;\r\n  margin: 0 auto;\r\n}\r\n\r\n.colleges-subnav-btn {\r\n  display: inline-flex