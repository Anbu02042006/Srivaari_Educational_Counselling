const __vite__css = "/* ==========================================================================\r\n   SRI VAARI EDUCATIONAL COUNSELLING\r\n   Human-Designed, Balanced Density UI Design System\r\n   ========================================================================== */\r\n\r\n/* --------------------------------------------------------------------------\r\n   1. DESIGN TOKENS\r\n   -------------------------------------------------------------------------- */\r\n:root {\r\n  /* --- Brand Colors: Refined Royal & Electric Blue --- */\r\n  --color-primary-950: #0a1128;\r\n  /* Deepest obsidian navy */\r\n  --color-primary-900: #0f172a;\r\n  /* Slate midnight navy */\r\n  --color-primary-800: #1e293b;\r\n  /* Charcoal navy */\r\n  --color-primary-700: #004ecc;\r\n  /* Deep royal blue */\r\n  --color-primary-600: #005ce6;\r\n  /* Rich electric blue */\r\n  --color-primary-500: #0066ff;\r\n  /* Signature Sri Vaari Electric Blue */\r\n  --color-primary-400: #388bfd;\r\n  /* Sky blue */\r\n  --color-primary-200: #cbd5e1;\r\n  /* Subtle border */\r\n  --color-primary-100: #f1f5f9;\r\n  /* Soft slate tint */\r\n  --color-primary-50: #f8fafc;\r\n  /* Canvas tint */\r\n\r\n  --color-primary: var(--color-primary-500);\r\n  --color-primary-dark: var(--color-primary-900);\r\n  --color-primary-soft: var(--color-primary-100);\r\n\r\n  /* Neutrals & Surfaces */\r\n  --color-canvas: #ffffff;\r\n  /* Pure white canvas */\r\n  --color-surface: #ffffff;\r\n  /* White card surface */\r\n  --color-surface-soft: #f8fafc;\r\n  /* Subtle cool surface */\r\n  --color-surface-tint: #f1f5f9;\r\n  /* Neutral section background */\r\n  --color-surface-dark: #0f172a;\r\n  /* Deep navy container */\r\n\r\n  /* Text & Ink */\r\n  --color-ink: #0f172a;\r\n  /* High-contrast charcoal navy */\r\n  --color-text: var(--color-ink);\r\n  --color-text-muted: #475569;\r\n  /* Readable neutral slate */\r\n  --color-text-subtle: #64748b;\r\n  /* Captions & metadata */\r\n  --color-text-inverse: #ffffff;\r\n  /* White text on dark */\r\n  --color-text-inverse-muted: #94a3b8;\r\n\r\n  /* Borders & Dividers */\r\n  --color-line: #e2e8f0;\r\n  /* Crisp clean border */\r\n  --color-border: var(--color-line);\r\n  --color-border-subtle: #f1f5f9;\r\n\r\n  /* Feedback */\r\n  --color-success: #16a34a;\r\n  --color-success-bg: #f0fdf4;\r\n  --color-success-border: #bbf7d0;\r\n  --color-danger: #dc2626;\r\n  --color-danger-bg: #fef2f2;\r\n  --color-warning: #d97706;\r\n\r\n  /* Typography Scale */\r\n  --font-sans: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;\r\n  --font-display: 'Outfit', 'Plus Jakarta Sans', -apple-system, sans-serif;\r\n\r\n  --font-size-display: clamp(2rem, 3.8vw, 3rem);\r\n  --font-size-h1: clamp(1.75rem, 3.2vw, 2.35rem);\r\n  --font-size-h2: clamp(1.35rem, 2.2vw, 1.75rem);\r\n  --font-size-h3: clamp(1.1rem, 1.2vw + 0.2rem, 1.25rem);\r\n  --font-size-h4: 1rem;\r\n  --font-size-body-lg: 1.025rem;\r\n  --font-size-body: 0.9375rem;\r\n  --font-size-body-sm: 0.85rem;\r\n  --font-size-caption: 0.75rem;\r\n  --font-size-btn: 0.875rem;\r\n\r\n  --font-weight-regular: 400;\r\n  --font-weight-medium: 500;\r\n  --font-weight-semibold: 600;\r\n  --font-weight-bold: 700;\r\n  --font-weight-extrabold: 800;\r\n\r\n  --line-height-tight: 1.15;\r\n  --line-height-heading: 1.22;\r\n  --line-height-body: 1.55;\r\n\r\n  /* Compact, Balanced Spacing */\r\n  --space-1: 0.25rem;\r\n  --space-2: 0.45rem;\r\n  --space-3: 0.65rem;\r\n  --space-4: 0.875rem;\r\n  --space-5: 1.15rem;\r\n  --space-6: 1.35rem;\r\n  --space-8: 1.75rem;\r\n  --space-10: 2rem;\r\n  --space-12: 2.5rem;\r\n  --space-16: 3rem;\r\n\r\n  --section-space: clamp(2rem, 3vw, 2.75rem);\r\n  --container: 78rem;\r\n  --container-narrow: 52rem;\r\n\r\n  /* Restrained Professional Radii */\r\n  --radius-xs: 0.25rem;\r\n  --radius-sm: 0.375rem;\r\n  --radius-md: 0.5rem;\r\n  --radius-lg: 0.75rem;\r\n  --radius-xl: 1rem;\r\n  --radius-2xl: 1.25rem;\r\n  --radius-card: 0.75rem;\r\n  --radius-pill: 9999px;\r\n\r\n  /* Subtle, Natural Shadows */\r\n  --shadow-xs: 0 1px 2px rgba(15, 23, 42, 0.04);\r\n  --shadow-sm: 0 2px 4px rgba(15, 23, 42, 0.04);\r\n  --shadow-md: 0 4px 12px -2px rgba(15, 23, 42, 0.06);\r\n  --shadow-lg: 0 10px 24px -4px rgba(15, 23, 42, 0.08);\r\n  --shadow-card: 0 1px 3px rgba(15, 23, 42, 0.04);\r\n  --shadow-card-hover: 0 6px 18px -3px rgba(15, 23, 42, 0.08);\r\n\r\n  --transition-fast: 140ms ease;\r\n  --transition-base: 200ms ease;\r\n}\r\n\r\n/* --------------------------------------------------------------------------\r\n   2. GLOBAL RESET & BASE\r\n   -------------------------------------------------------------------------- */\r\n*,\r\n*::before,\r\n*::after {\r\n  box-sizing: border-box;\r\n  -webkit-tap-highlight-color: transparent;\r\n}\r\n\r\nhtml {\r\n  min-width: 320px;\r\n  width: 100%;\r\n  max-width: 100%;\r\n  overflow-x: hidden;\r\n  scroll-behavior: smooth;\r\n  -webkit-text-size-adjust: 100%;\r\n  text-size-adjust: 100%;\r\n  text-rendering: optimizeLegibility;\r\n  -webkit-font-smoothing: antialiased;\r\n  -moz-osx-font-smoothing: grayscale;\r\n}\r\n\r\nbody {\r\n  min-width: 320px;\r\n  width: 100%;\r\n  max-width: 100%;\r\n  min-height: 100vh;\r\n  min-height: 100dvh;\r\n  margin: 0;\r\n  color: var(--color-ink);\r\n  background-color: var(--color-canvas);\r\n  font-family: var(--font-sans);\r\n  font-size: var(--font-size-body);\r\n  line-height: var(--line-height-body);\r\n  -webkit-font-smoothing: antialiased;\r\n  -moz-osx-font-smoothing: grayscale;\r\n  overflow-x: hidden;\r\n  position: relative;\r\n}\r\n\r\nbutton,\r\na,\r\ninput,\r\nselect,\r\ntextarea {\r\n  touch-action: manipulation;\r\n  font-family: inherit;\r\n}\r\n\r\ninput,\r\nselect,\r\ntextarea {\r\n  -webkit-appearance: none;\r\n  -moz-appearance: none;\r\n  appearance: none;\r\n  border-radius: 0;\r\n}\r\n\r\n#root {\r\n  display: flex;\r\n  flex-direction: column;\r\n  min-height: 100vh;\r\n  min-height: 100dvh;\r\n  width: 100%;\r\n  max-width: 100%;\r\n  overflow-x: hidden;\r\n}\r\n\r\n.app-shell {\r\n  display: flex;\r\n  flex-direction: column;\r\n  min-height: 100vh;\r\n  min-height: 100dvh;\r\n  width: 100%;\r\n}\r\n\r\n.app-shell__main {\r\n  flex: 1 0 auto;\r\n  width: 100%;\r\n}\r\n\r\n::selection {\r\n  color: #ffffff;\r\n  background-color: var(--color-primary-500);\r\n}\r\n\r\n#contact,\r\n#enquire {\r\n  scroll-margin-top: 5rem;\r\n}\r\n\r\nh1,\r\nh2,\r\nh3,\r\nh4,\r\nh5,\r\nh6,\r\np,\r\nul,\r\nol,\r\nfigure,\r\nblockquote {\r\n  margin-top: 0;\r\n}\r\n\r\nh1,\r\nh2,\r\nh3,\r\nh4 {\r\n  color: var(--color-ink);\r\n  font-family: var(--font-display);\r\n  font-weight: 700;\r\n  line-height: var(--line-height-heading);\r\n  letter-spacing: -0.025em;\r\n  margin-bottom: 0.35rem;\r\n}\r\n\r\nh1 {\r\n  font-size: var(--font-size-h1);\r\n}\r\n\r\nh2 {\r\n  font-size: var(--font-size-h2);\r\n}\r\n\r\nh3 {\r\n  font-size: var(--font-size-h3);\r\n}\r\n\r\nh4 {\r\n  font-size: var(--font-size-h4);\r\n}\r\n\r\np {\r\n  margin-bottom: 0.65rem;\r\n  color: var(--color-text-muted);\r\n}\r\n\r\np:last-child {\r\n  margin-bottom: 0;\r\n}\r\n\r\na {\r\n  color: inherit;\r\n  text-decoration: none;\r\n  transition: color var(--transition-fast);\r\n}\r\n\r\nimg,\r\nsvg,\r\npicture,\r\nvideo {\r\n  display: block;\r\n  max-width: 100%;\r\n  height: auto;\r\n}\r\n\r\nbutton,\r\ninput,\r\ntextarea,\r\nselect {\r\n  font: inherit;\r\n  color: inherit;\r\n}\r\n\r\nbutton {\r\n  background: none;\r\n  border: none;\r\n  padding: 0;\r\n  cursor: pointer;\r\n}\r\n\r\n:focus-visible {\r\n  outline: 2px solid var(--color-primary-500);\r\n  outline-offset: 2px;\r\n  border-radius: var(--radius-xs);\r\n}\r\n\r\n.container {\r\n  width: min(100% - 2rem, var(--container));\r\n  margin-left: auto;\r\n  margin-right: auto;\r\n}\r\n\r\n.container-narrow {\r\n  width: min(100% - 2rem, var(--container-narrow));\r\n  margin-left: auto;\r\n  margin-right: auto;\r\n}\r\n\r\n@media (min-width: 64rem) {\r\n  :root {\r\n    --container: 80rem;\r\n    --container-narrow: 54rem;\r\n  }\r\n\r\n  .container {\r\n    width: min(100% - 3rem, var(--container));\r\n  }\r\n\r\n  .container-narrow {\r\n    width: min(100% - 3rem, var(--container-narrow));\r\n  }\r\n}\r\n\r\n@media (min-width: 90rem) {\r\n  :root {\r\n    --container: 84rem;\r\n  }\r\n\r\n  .container {\r\n    width: min(100% - 3.5rem, var(--container));\r\n  }\r\n}\r\n\r\n@media (min-width: 105rem) {\r\n  :root {\r\n    --container: 88rem;\r\n  }\r\n\r\n  .container {\r\n    width: min(100% - 4rem, var(--container));\r\n  }\r\n}\r\n\r\nmain {\r\n  width: 100%;\r\n}\r\n\r\n/* --------------------------------------------------------------------------\r\n   3. BUTTONS (Professional, Balanced)\r\n   -------------------------------------------------------------------------- */\r\n.button {\r\n  display: inline-flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n  gap: var(--space-2);\r\n  min-height: 2.5rem;\r\n  padding: 0.5rem 1.15rem;\r\n  border: 1px solid transparent;\r\n  border-radius: var(--radius-md);\r\n  font-family: var(--font-sans);\r\n  font-size: var(--font-size-btn);\r\n  font-weight: 600;\r\n  line-height: 1.2;\r\n  white-space: nowrap;\r\n  user-select: none;\r\n  cursor: pointer;\r\n  transition: all var(--transition-fast);\r\n}\r\n\r\n.button:hover {\r\n  transform: translateY(-1px);\r\n}\r\n\r\n.button:active {\r\n  transform: translateY(0);\r\n}\r\n\r\n.button:disabled {\r\n  opacity: 0.6;\r\n  cursor: not-allowed;\r\n  transform: none;\r\n}\r\n\r\n.button--primary {\r\n  color: #ffffff !important;\r\n  background: linear-gradient(135deg, #4f8cff 0%, #6a5cff 100%) !important;\r\n  border: none !important;\r\n  box-shadow: 0 4px 14px rgba(79, 140, 255, 0.35);\r\n}\r\n\r\n.button--primary:hover {\r\n  transform: translateY(-2px) scale(1.02);\r\n  box-shadow: 0 6px 20px rgba(79, 140, 255, 0.45);\r\n}\r\n\r\n.button--secondary {\r\n  color: var(--color-ink);\r\n  background-color: var(--color-surface);\r\n  border-color: var(--color-line);\r\n}\r\n\r\n.button--secondary:hover {\r\n  background-color: var(--color-surface-soft);\r\n  border-color: var(--color-primary-200);\r\n  color: var(--color-primary-500);\r\n}\r\n\r\n.button--accent {\r\n  color: #ffffff;\r\n  background-color: var(--color-primary-900);\r\n  border-color: var(--color-primary-900);\r\n}\r\n\r\n.button--accent:hover {\r\n  background-color: var(--color-primary-950);\r\n}\r\n\r\n/* --------------------------------------------------------------------------\r\n   3.1 DESKTOP GOOEY BLOB BUTTON ANIMATION\r\n   Strictly for desktop viewports (>= 769px / min-width: 48.01rem).\r\n   Maintains button color palette & fluid text sizes while animating organic blobs.\r\n   -------------------------------------------------------------------------- */\r\n@media (min-width: 48.01rem) {\r\n  .button,\r\n  .btn,\r\n  .blob-btn {\r\n    position: relative !important;\r\n    z-index: 1 !important;\r\n    isolation: isolate !important;\r\n    overflow: hidden !important;\r\n    transition: color 0.45s cubic-bezier(0.16, 1, 0.3, 1),\r\n                border-color 0.4s ease,\r\n                box-shadow 0.4s ease,\r\n                transform var(--transition-fast) !important;\r\n  }\r\n\r\n  /* When blob animation container is attached, button delegates its background to inner */\r\n  .button.has-blob-animation,\r\n  .button:has(.blob-btn__inner),\r\n  .btn.has-blob-animation,\r\n  .btn:has(.blob-btn__inner),\r\n  .blob-btn {\r\n    background: transparent !important;\r\n  }\r\n\r\n  /* Keep all content (text, icons, badges) elevated above rising blobs */\r\n  .button > *:not(.blob-btn__inner),\r\n  .btn > *:not(.blob-btn__inner),\r\n  .blob-btn > *:not(.blob-btn__inner) {\r\n    position: relative;\r\n    z-index: 2;\r\n    transition: color 0.45s ease, stroke 0.45s ease, fill 0.45s ease;\r\n  }\r\n\r\n  /* Inner container (clips overflowing blobs to button curvature) */\r\n  .blob-btn__inner {\r\n    z-index: -1;\r\n    overflow: hidden;\r\n    position: absolute;\r\n    left: 0;\r\n    top: 0;\r\n    width: 100%;\r\n    height: 100%;\r\n    border-radius: inherit;\r\n    pointer-events: none;\r\n    transition: background 0.4s ease;\r\n  }\r\n\r\n  /* Gooey filter container */\r\n  .blob-btn__blobs {\r\n    position: relative;\r\n    display: block;\r\n    height: 100%;\r\n    width: 100%;\r\n    filter: url('#goo');\r\n  }\r\n\r\n  /* Individual organic blobs */\r\n  .blob-btn__blob {\r\n    position: absolute;\r\n    top: 0;\r\n    width: 32%;\r\n    height: 100%;\r\n    border-radius: 100%;\r\n    transform: translate3d(0, 150%, 0) scale(1.7);\r\n    transition: transform 0.45s cubic-bezier(0.25, 0.46, 0.45, 0.94);\r\n    will-change: transform;\r\n  }\r\n\r\n  @supports (filter: url('#goo')) {\r\n    .blob-btn__blob {\r\n      transform: translate3d(0, 150%, 0) scale(1.4);\r\n    }\r\n  }\r\n\r\n  .blob-btn__blob:nth-child(1) {\r\n    left: 0%;\r\n    transition-delay: 0s;\r\n  }\r\n\r\n  .blob-btn__blob:nth-child(2) {\r\n    left: 26%;\r\n    transition-delay: 0.08s;\r\n  }\r\n\r\n  .blob-btn__blob:nth-child(3) {\r\n    left: 52%;\r\n    transition-delay: 0.16s;\r\n  }\r\n\r\n  .blob-btn__blob:nth-child(4) {\r\n    left: 78%;\r\n    transition-delay: 0.24s;\r\n  }\r\n\r\n  /* Hover effect: Blobs rise and merge seamlessly across the button */\r\n  .button:hover:not(:disabled) .blob-btn__blob,\r\n  .btn:hover:not(:disabled) .blob-btn__blob,\r\n  .blob-btn:hover:not(:disabled) .blob-btn__blob {\r\n    transform: translateZ(0) scale(1.7);\r\n  }\r\n\r\n  @supports (filter: url('#goo')) {\r\n    .button:hover:not(:disabled) .blob-btn__blob,\r\n    .btn:hover:not(:disabled) .blob-btn__blob,\r\n    .blob-btn:hover:not(:disabled) .blob-btn__blob {\r\n      transform: translateZ(0) scale(1.4);\r\n    }\r\n  }\r\n\r\n  /* Primary Button Styling */\r\n  .button--primary .blob-btn__inner {\r\n    background: linear-gradient(135deg, #4f8cff 0%, #6a5cff 100%);\r\n  }\r\n\r\n  .button--primary .blob-btn__blob {\r\n    background: #0505A9;\r\n  }\r\n\r\n  .button--primary:hover:not(:disabled) {\r\n    color: #ffffff !important;\r\n    box-shadow: 0 6px 22px rgba(5, 5, 169, 0.5) !important;\r\n  }\r\n\r\n  .button--primary:hover:not(:disabled) > *:not(.blob-btn__inner) {\r\n    color: #ffffff !important;\r\n    stroke: #ffffff !important;\r\n  }\r\n\r\n  /* Secondary Button Styling */\r\n  .button--secondary .blob-btn__inner {\r\n    background: var(--color-surface, #ffffff);\r\n  }\r\n\r\n  .button--secondary .blob-btn__blob {\r\n    background: #0505A9;\r\n  }\r\n\r\n  .button--secondary:hover:not(:disabled) {\r\n    color: #ffffff !important;\r\n    border-color: #0505A9 !important;\r\n  }\r\n\r\n  .button--secondary:hover:not(:disabled) > *:not(.blob-btn__inner) {\r\n    color: #ffffff !important;\r\n    stroke: #ffffff !important;\r\n  }\r\n\r\n  /* Page-Hero Secondary Glass Button Variant */\r\n  .page-hero .button--secondary .blob-btn__inner {\r\n    background: rgba(255, 255, 255, 0.15);\r\n  }\r\n\r\n  .page-hero .button--secondary .blob-btn__blob {\r\n    background: #0505A9;\r\n  }\r\n\r\n  .page-hero .button--secondary:hover:not(:disabled) {\r\n    color: #ffffff !important;\r\n    border-color: rgba(255, 255, 255, 0.8) !important;\r\n  }\r\n\r\n  /* Accent Button Styling */\r\n  .button--accent .blob-btn__inner {\r\n    background: var(--color-primary-900, #0a1e3f);\r\n  }\r\n\r\n  .button--accent .blob-btn__blob {\r\n    background: #3b82f6;\r\n  }\r\n\r\n  .button--accent:hover:not(:disabled) {\r\n    color: #ffffff !important;\r\n    border-color: #3b82f6 !important;\r\n  }\r\n\r\n  .button--accent:hover:not(:disabled) > *:not(.blob-btn__inner) {\r\n    color: #ffffff !important;\r\n    stroke: #ffffff !important;\r\n  }\r\n\r\n  /* Default / Unstyled Blob Button Fallback */\r\n  .blob-btn .blob-btn__inner {\r\n    background: #ffffff;\r\n  }\r\n\r\n  .blob-btn .blob-btn__blob {\r\n    background: #0505A9;\r\n  }\r\n\r\n  .blob-btn:hover:not(:disabled) {\r\n    color: #ffffff !important;\r\n  }\r\n\r\n  /* Disabled State Handling */\r\n  .button:disabled,\r\n  .button[disabled] {\r\n    cursor: not-allowed;\r\n    opacity: 0.6;\r\n  }\r\n\r\n  .button:disabled .blob-btn__blob,\r\n  .button[disabled] .blob-btn__blob {\r\n    transform: translate3d(0, 150%, 0) scale(1.7) !important;\r\n    transition: none !important;\r\n  }\r\n}\r\n\r\n/* Mobile: Blob animation strictly disabled to maintain instant touch responsiveness */\r\n@media (max-width: 48rem) {\r\n  .blob-btn__inner {\r\n    display: none !important;\r\n  }\r\n}\r\n\r\n.text-link {\r\n  display: inline-flex;\r\n  align-items: center;\r\n  gap: 0.25rem;\r\n  color: var(--color-primary-500);\r\n  font-weight: 600;\r\n  font-size: var(--font-size-body-sm);\r\n  background: none;\r\n  border: 0;\r\n  cursor: pointer;\r\n  transition: color var(--transition-fast);\r\n}\r\n\r\n.text-link:hover {\r\n  color: var(--color-primary-700);\r\n}\r\n\r\n.text-link svg {\r\n  transition: transform var(--transition-fast);\r\n}\r\n\r\n.text-link:hover svg {\r\n  transform: translate(2px, -2px);\r\n}\r\n\r\n/* --------------------------------------------------------------------------\r\n   4. BRAND & HEADER\r\n   -------------------------------------------------------------------------- */\r\n.brand {\r\n  display: inline-flex;\r\n  align-items: center;\r\n  gap: 0.55rem;\r\n  color: var(--color-ink);\r\n  font-weight: 700;\r\n  text-decoration: none;\r\n  user-select: none;\r\n}\r\n\r\n.brand__img {\r\n  width: 2.1rem;\r\n  height: 2.1rem;\r\n  object-fit: contain;\r\n  border-radius: var(--radius-sm);\r\n}\r\n\r\n.brand__text {\r\n  font-family: var(--font-display);\r\n  font-size: 1.1rem;\r\n  font-weight: 800;\r\n  letter-spacing: -0.02em;\r\n  color: var(--color-ink);\r\n}\r\n\r\n.brand--dark {\r\n  display: inline-flex;\r\n  align-items: center;\r\n  gap: 0.75rem;\r\n}\r\n\r\n.brand--dark .brand__img {\r\n  width: 2.65rem;\r\n  height: 2.65rem;\r\n  background-color: #ffffff;\r\n  padding: 4px;\r\n  border-radius: 10px;\r\n  box-shadow: 0 4px 14px rgba(0, 0, 0, 0.3);\r\n  display: block;\r\n}\r\n\r\n.brand--dark .brand__text {\r\n  color: #ffffff;\r\n  font-size: 1.25rem;\r\n  font-weight: 800;\r\n  letter-spacing: -0.01em;\r\n}\r\n\r\n.site-header {\r\n  position: fixed !important;\r\n  top: 0;\r\n  left: 0;\r\n  right: 0;\r\n  width: 100%;\r\n  z-index: 1000;\r\n  background-color: #1e50d8; /* Rich Royal Blue from svgedugroups.com */\r\n  border-bottom: 1px solid rgba(255, 255, 255, 0.14);\r\n  box-shadow: 0 4px 20px rgba(0, 0, 0, 0.16);\r\n  transform: translateY(0) !important;\r\n  opacity: 1 !important;\r\n  pointer-events: auto !important;\r\n  transition: background-color 0.25s ease, box-shadow 0.25s ease;\r\n}\r\n\r\n.site-header--scrolled {\r\n  box-shadow: 0 8px 25px rgba(0, 0, 0, 0.22) !important;\r\n}\r\n\r\n/* Offset for main content across all pages */\r\n.app-shell__main {\r\n  padding-top: 3.85rem;\r\n}\r\n\r\n@media (min-width: 58rem) {\r\n  .app-shell__main {\r\n    padding-top: 4.25rem;\r\n  }\r\n}\r\n\r\n.navbar {\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: space-between;\r\n  min-height: 3.85rem;\r\n  position: relative;\r\n  gap: var(--space-3);\r\n}\r\n\r\n/* Desktop Navigation Menu */\r\n.nav__desktop-menu {\r\n  display: none;\r\n}\r\n\r\n.nav__actions--desktop {\r\n  display: none;\r\n}\r\n\r\n.nav__hamburger-btn {\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n  width: 2.5rem;\r\n  height: 2.5rem;\r\n  padding: 0;\r\n  background: transparent;\r\n  border: none !important;\r\n  outline: none !important;\r\n  box-shadow: none !important;\r\n  color: #ffffff !important;\r\n  cursor: pointer;\r\n  transition: opacity var(--transition-fast), transform var(--transition-fast);\r\n  -webkit-tap-highlight-color: transparent;\r\n}\r\n\r\n.nav__hamburger-btn:hover {\r\n  background: transparent;\r\n  opacity: 0.85;\r\n}\r\n\r\n.nav__hamburger-btn:active {\r\n  transform: scale(0.92);\r\n}\r\n\r\n/* ==========================================================================\r\n   MOBILE DRAWER NAVIGATION SLIDE-OVER PANEL (High-Priority Overlay)\r\n   ========================================================================== */\r\n.mobile-drawer-backdrop {\r\n  position: fixed !important;\r\n  inset: 0 !important;\r\n  background-color: rgba(15, 23, 42, 0.6) !important;\r\n  backdrop-filter: blur(4px) !important;\r\n  -webkit-backdrop-filter: blur(4px) !important;\r\n  z-index: 999998 !important;\r\n  animation: fadeIn 0.2s ease forwards !important;\r\n}\r\n\r\n.mobile-drawer {\r\n  position: fixed !important;\r\n  top: 0 !important;\r\n  right: 0 !important;\r\n  bottom: 0 !important;\r\n  width: min(84vw, 320px) !important;\r\n  height: 100vh !important;\r\n  height: 100dvh !important;\r\n  background-color: #ffffff !important;\r\n  z-index: 999999 !important;\r\n  transform: translateX(100%) !important;\r\n  transition: transform 0.28s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.2s ease, visibility 0.28s !important;\r\n  box-shadow: -6px 0 30px rgba(0, 0, 0, 0.15) !important;\r\n  display: flex !important;\r\n  flex-direction: column !important;\r\n  visibility: hidden !important;\r\n  pointer-events: none !important;\r\n  opacity: 0 !important;\r\n}\r\n\r\n.mobile-drawer--open {\r\n  transform: translateX(0) !important;\r\n  visibility: visible !important;\r\n  pointer-events: auto !important;\r\n  opacity: 1 !important;\r\n}\r\n\r\n.mobile-drawer__content {\r\n  display: flex;\r\n  flex-direction: column;\r\n  height: 100%;\r\n  padding: 0 !important;\r\n  overflow-y: auto;\r\n  -webkit-overflow-scrolling: touch;\r\n  box-sizing: border-box;\r\n  background-color: #ffffff;\r\n}\r\n\r\n.mobile-drawer__header {\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: space-between;\r\n  padding: 1.15rem 1.5rem;\r\n  border-bottom: 1px solid #dcdcdc;\r\n  background-color: #ffffff;\r\n  margin-bottom: 0;\r\n}\r\n\r\n.mobile-drawer__close-btn {\r\n  width: 36px;\r\n  height: 36px;\r\n  border-radius: var(--radius-pill);\r\n  background-color: transparent;\r\n  border: 1px solid #e5e7eb;\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n  color: #111827;\r\n  cursor: pointer;\r\n  transition: background-color 0.15s ease, color 0.15s ease, border-color 0.15s ease;\r\n}\r\n\r\n.mobile-drawer__close-btn:hover {\r\n  background-color: #111827;\r\n  border-color: #111827;\r\n  color: #ffffff;\r\n}\r\n\r\n.mobile-drawer__nav {\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 0;\r\n  width: 100%;\r\n  margin: 0;\r\n  padding: 0;\r\n}\r\n\r\n.mobile-drawer__link {\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: flex-start;\r\n  padding: 1.15rem 1.5rem;\r\n  font-family: var(--font-sans);\r\n  font-size: 0.98rem;\r\n  font-weight: 800;\r\n  letter-spacing: 0.04em;\r\n  text-transform: uppercase;\r\n  color: #000000;\r\n  text-decoration: none;\r\n  border-bottom: 1px solid #dcdcdc;\r\n  border-radius: 0;\r\n  background-color: #ffffff;\r\n  transition: background-color 0.15s ease, color 0.15s ease, padding-left 0.15s ease;\r\n}\r\n\r\n.mobile-drawer__link:hover {\r\n  background-color: #f8fafc;\r\n  color: #000000;\r\n  padding-left: 1.75rem;\r\n}\r\n\r\n.mobile-drawer__link--active {\r\n  background-color: #f8fafc;\r\n  color: #000000;\r\n  font-weight: 800;\r\n  border-left: 4px solid #000000;\r\n  padding-left: calc(1.5rem - 4px);\r\n}\r\n\r\n.mobile-drawer__secondary {\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 1.25rem;\r\n  padding: 1.75rem 1.5rem calc(1.75rem + env(safe-area-inset-bottom, 15px));\r\n  background-color: #ffffff;\r\n}\r\n\r\n.mobile-drawer__secondary-link {\r\n  display: flex;\r\n  align-items: center;\r\n  font-family: var(--font-sans);\r\n  font-size: 0.82rem;\r\n  font-weight: 500;\r\n  letter-spacing: 0.06em;\r\n  text-transform: uppercase;\r\n  color: #111827;\r\n  text-decoration: none;\r\n  background: none;\r\n  border: none;\r\n  padding: 0;\r\n  text-align: left;\r\n  cursor: pointer;\r\n  transition: color 0.15s ease, opacity 0.15s ease;\r\n}\r\n\r\n.mobile-drawer__secondary-link:hover {\r\n  color: #000000;\r\n  opacity: 0.8;\r\n}\r\n\r\n.mobile-drawer__secondary-link strong {\r\n  font-weight: 800;\r\n  color: #000000;\r\n  margin-left: 0.35rem;\r\n}\r\n\r\n.mobile-drawer__secondary-link--cta {\r\n  font-weight: 800;\r\n  color: var(--color-primary-600);\r\n}\r\n\r\n.mobile-drawer__secondary-link--cta:hover {\r\n  color: var(--color-primary-700);\r\n}\r\n\r\n/* ==========================================================================\r\n   DESKTOP ROYAL BLUE NAVBAR & MEGA MENUS (DOMESTIC & ABROAD STUDIES)\r\n   ========================================================================== */\r\n.nav__dropdown-wrapper {\r\n  position: relative;\r\n}\r\n\r\n/* Mega dropdowns anchor across the navbar container so wide multi-column menus stay centered without clipping */\r\n.nav__dropdown-wrapper--mega,\r\n.nav__dropdown-wrapper:has(.mega-menu--domestic),\r\n.nav__dropdown-wrapper:has(.mega-menu--abroad) {\r\n  position: static;\r\n}\r\n\r\n.nav__menu-item {\r\n  color: #ffffff;\r\n  font-family: var(--font-sans);\r\n  font-size: clamp(0.72rem, 0.85vw, 0.82rem);\r\n  font-weight: 750;\r\n  letter-spacing: 0.04em;\r\n  text-transform: uppercase;\r\n  text-decoration: none;\r\n  padding: 0.48rem 0.65rem;\r\n  border-radius: 6px;\r\n  background: transparent;\r\n  border: none;\r\n  cursor: pointer;\r\n  display: inline-flex;\r\n  align-items: center;\r\n  gap: 0.3rem;\r\n  white-space: nowrap;\r\n  transition: background-color 0.15s ease, opacity 0.15s ease;\r\n}\r\n\r\n.nav__menu-item:hover,\r\n.nav__menu-item--active {\r\n  background-color: rgba(255, 255, 255, 0.18);\r\n  color: #ffffff;\r\n}\r\n\r\n.nav__chevron-icon {\r\n  color: #ffffff;\r\n  transition: transform 0.2s ease;\r\n  flex-shrink: 0;\r\n}\r\n\r\n.nav__dropdown-wrapper--open .nav__chevron-icon {\r\n  transform: rotate(180deg);\r\n}\r\n\r\n/* Mega Menus (Desktop Dropdown Panels) */\r\n.mega-menu {\r\n  position: absolute;\r\n  top: calc(100% + 8px);\r\n  z-index: 1050;\r\n  background-color: #ffffff;\r\n  border-radius: 16px;\r\n  box-shadow: 0 24px 48px -12px rgba(15, 23, 42, 0.22), 0 0 0 1px rgba(15, 23, 42, 0.08);\r\n  border: 1px solid #e2e8f0;\r\n  padding: 1.6rem 1.85rem;\r\n  animation: megaMenuSlideDown 0.2s cubic-bezier(0.16, 1, 0.3, 1);\r\n  pointer-events: auto;\r\n  box-sizing: border-box;\r\n}\r\n\r\n/* Invisible hover bridge between navbar item and dropdown */\r\n.mega-menu::before {\r\n  content: '';\r\n  position: absolute;\r\n  top: -16px;\r\n  left: 0;\r\n  right: 0;\r\n  height: 16px;\r\n}\r\n\r\n@keyframes megaMenuSlideDown {\r\n  from {\r\n    opacity: 0;\r\n    transform: translateX(-50%) translateY(-6px);\r\n  }\r\n  to {\r\n    opacity: 1;\r\n    transform: translateX(-50%) translateY(0);\r\n  }\r\n}\r\n\r\n.mega-menu--domestic {\r\n  left: 50%;\r\n  transform: translateX(-50%);\r\n  width: min(1040px, calc(100% - 2rem));\r\n  max-width: calc(100vw - 2rem);\r\n}\r\n\r\n.mega-menu--abroad {\r\n  left: 50%;\r\n  transform: translateX(-50%);\r\n  width: min(600px, calc(100% - 2rem));\r\n  max-width: calc(100vw - 2rem);\r\n}\r\n\r\n.mega-menu--abroad .mega-menu__grid {\r\n  grid-template-columns: repeat(2, 1fr);\r\n  gap: 1.5rem;\r\n}\r\n\r\n.mega-menu__grid {\r\n  display: grid;\r\n  grid-template-columns: repeat(3, 1fr);\r\n  gap: 1.5rem;\r\n  align-items: stretch;\r\n}\r\n\r\n.mega-menu__column {\r\n  padding: 0;\r\n  padding-right: 1.5rem;\r\n  border-right: 1px solid #e2e8f0;\r\n  display: flex;\r\n  flex-direction: column;\r\n}\r\n\r\n.mega-menu__column:last-child {\r\n  padding-right: 0;\r\n  border-right: none;\r\n}\r\n\r\n.mega-menu__column-title {\r\n  font-size: 0.72rem;\r\n  font-weight: 800;\r\n  letter-spacing: 0.08em;\r\n  text-transform: uppercase;\r\n  color: #64748b;\r\n  mar