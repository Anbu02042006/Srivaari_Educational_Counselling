\n\r\n.testimonial-slider__meta {\r\n  display: flex;\r\n  flex-direction: column;\r\n}\r\n\r\n.testimonial-slider__name {\r\n  font-size: 0.92rem;\r\n  color: #ffffff !important;\r\n  font-weight: 700;\r\n}\r\n\r\n.testimonial-slider__detail {\r\n  font-size: 0.78rem;\r\n  color: #e0f2fe !important;\r\n}\r\n\r\n/* --------------------------------------------------------------------------\r\n   10. GALLERY (Structured Photography Grid & Clean Filter)\r\n   -------------------------------------------------------------------------- */\r\n.gallery-section {\r\n  padding: var(--section-space) 0;\r\n}\r\n\r\n.gallery-header {\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 0.75rem;\r\n  margin-bottom: 1.15rem;\r\n}\r\n\r\n.gallery-header--no-heading {\r\n  margin-bottom: 1.25rem;\r\n  justify-content: flex-start;\r\n}\r\n\r\n@media (min-width: 58rem) {\r\n  .gallery-header {\r\n    flex-direction: row;\r\n    align-items: flex-end;\r\n    justify-content: space-between;\r\n  }\r\n\r\n  .gallery-header--no-heading {\r\n    justify-content: flex-start;\r\n  }\r\n\r\n  .gallery-header .section-heading {\r\n    margin-bottom: 0;\r\n  }\r\n}\r\n\r\n.category-filter {\r\n  display: flex;\r\n  flex-wrap: wrap;\r\n  align-items: center;\r\n  gap: 0.4rem;\r\n}\r\n\r\n.category-filter__pill {\r\n  padding: 0.35rem 0.85rem;\r\n  border-radius: var(--radius-md);\r\n  background-color: #ffffff;\r\n  border: 1px solid var(--color-line);\r\n  color: var(--color-text-muted);\r\n  font-size: 0.8125rem;\r\n  font-weight: 600;\r\n  cursor: pointer;\r\n  white-space: nowrap;\r\n  transition: all var(--transition-fast);\r\n}\r\n\r\n.category-filter__pill:hover {\r\n  background-color: var(--color-surface-soft);\r\n  color: var(--color-ink);\r\n}\r\n\r\n.category-filter__pill.is-active {\r\n  background-color: var(--color-primary-500);\r\n  color: #ffffff;\r\n  border-color: var(--color-primary-500);\r\n}\r\n\r\n@media (max-width: 48rem) {\r\n  .category-filter {\r\n    display: flex;\r\n    width: 100%;\r\n    max-width: 100%;\r\n    box-sizing: border-box;\r\n    flex-wrap: nowrap;\r\n    overflow-x: auto;\r\n    -webkit-overflow-scrolling: touch;\r\n    padding-bottom: 0.4rem;\r\n    scrollbar-width: none;\r\n    -ms-overflow-style: none;\r\n  }\r\n\r\n  .category-filter::-webkit-scrollbar {\r\n    display: none;\r\n  }\r\n\r\n  .category-filter__pill {\r\n    flex-shrink: 0;\r\n  }\r\n}\r\n\r\n/* ==========================================================================\r\n   10. GALLERY (Desktop: 4-Column Clean Rows | Mobile: 2-Column Staggered)\r\n   ========================================================================== */\r\n.gallery-section {\r\n  padding-top: clamp(0.6rem, 2vw, 1rem) !important;\r\n}\r\n\r\n.gallery-container {\r\n  max-width: var(--container-width, 76rem);\r\n  width: 100%;\r\n  margin: 0 auto;\r\n  padding: 0 1.25rem;\r\n}\r\n\r\n@media (min-width: 64rem) {\r\n  .gallery-container {\r\n    max-width: 88rem;\r\n    /* 1408px - generous desktop container with ample breathing room */\r\n    padding: 0 2.5rem;\r\n    /* 40px comfortable horizontal breathing room */\r\n  }\r\n}\r\n\r\n/* Compact Header */\r\n.gallery-section-header {\r\n  margin-top: 0;\r\n  margin-bottom: 0.65rem;\r\n}\r\n\r\n.gallery-section-header__title {\r\n  margin-top: 0;\r\n  margin-bottom: 0.2rem;\r\n  font-size: clamp(1.35rem, 2.5vw, 1.75rem);\r\n  font-weight: 800;\r\n  color: var(--color-ink);\r\n  letter-spacing: -0.02em;\r\n}\r\n\r\n.gallery-section-header__desc {\r\n  margin: 0;\r\n  font-size: clamp(0.85rem, 1.5vw, 0.92rem);\r\n  color: var(--color-text-muted);\r\n}\r\n\r\n/* Minimal Category Filters */\r\n.gallery-filters {\r\n  display: flex;\r\n  flex-wrap: wrap;\r\n  align-items: center;\r\n  gap: 0.55rem;\r\n  margin-top: 0.25rem;\r\n}\r\n\r\n.gallery-filter-pill {\r\n  padding: 0.5rem 1.15rem;\r\n  border-radius: var(--radius-md);\r\n  background-color: #ffffff;\r\n  border: 1px solid var(--color-line);\r\n  color: var(--color-text-muted);\r\n  font-size: 0.9rem;\r\n  font-weight: 600;\r\n  cursor: pointer;\r\n  white-space: nowrap;\r\n  transition: all var(--transition-fast);\r\n}\r\n\r\n.gallery-filter-pill:hover {\r\n  background-color: var(--color-surface-soft);\r\n  color: var(--color-ink);\r\n}\r\n\r\n.gallery-filter-pill.is-active {\r\n  background-color: var(--color-primary-500);\r\n  color: #ffffff;\r\n  border-color: var(--color-primary-500);\r\n  box-shadow: 0 3px 10px rgba(0, 102, 255, 0.22);\r\n}\r\n\r\n/* 4-COLUMN HORIZONTAL ROWS ON DESKTOP */\r\n.gallery-grid {\r\n  display: grid;\r\n  grid-template-columns: repeat(4, minmax(0, 1fr));\r\n  gap: 20px;\r\n  width: 100%;\r\n  box-sizing: border-box;\r\n}\r\n\r\n/* Tablet (768px - 1023px): 2 Equal-Height Columns */\r\n@media (min-width: 48.01rem) and (max-width: 63.99rem) {\r\n  .gallery-grid {\r\n    grid-template-columns: repeat(2, minmax(0, 1fr));\r\n    gap: 18px;\r\n  }\r\n}\r\n\r\n/* Individual Image-First Card (Desktop: Equal Height Across Rows) */\r\n.gallery-image-card {\r\n  position: relative;\r\n  border-radius: 18px;\r\n  overflow: hidden;\r\n  background-color: #0f172a;\r\n  box-shadow: 0 6px 18px -4px rgba(15, 23, 42, 0.1);\r\n  cursor: pointer;\r\n  outline: none;\r\n  width: 100%;\r\n  aspect-ratio: 4 / 3.4;\r\n  min-height: 260px;\r\n  max-height: 310px;\r\n  transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.3s ease;\r\n  user-select: none;\r\n  box-sizing: border-box;\r\n}\r\n\r\n.gallery-image-card:hover {\r\n  transform: translateY(-4px) scale(1.015);\r\n  box-shadow: 0 14px 28px -6px rgba(0, 102, 255, 0.2);\r\n}\r\n\r\n/* Sliding Track Container for Multi-Image Items */\r\n.gallery-image-card__track {\r\n  position: absolute;\r\n  inset: 0;\r\n  display: flex;\r\n  width: 100%;\r\n  height: 100%;\r\n  transition: transform 0.4s cubic-bezier(0.2, 0.8, 0.2, 1);\r\n  z-index: 1;\r\n}\r\n\r\n.gallery-image-card__slide {\r\n  min-width: 100%;\r\n  width: 100%;\r\n  height: 100%;\r\n}\r\n\r\n.gallery-image-card__img {\r\n  width: 100%;\r\n  height: 100%;\r\n  object-fit: cover;\r\n  object-position: center 30%;\r\n  display: block;\r\n  transition: transform 0.45s ease;\r\n}\r\n\r\n.gallery-image-card:hover .gallery-image-card__img {\r\n  transform: scale(1.03);\r\n}\r\n\r\n/* Center Overlay & Typography Matching Mobile Screenshot on ALL Views */\r\n.gallery-image-card__overlay {\r\n  position: absolute;\r\n  inset: 0;\r\n  background: linear-gradient(to bottom,\r\n      rgba(0, 0, 0, 0.15) 0%,\r\n      rgba(0, 0, 0, 0.42) 50%,\r\n      rgba(0, 0, 0, 0.68) 100%);\r\n  display: flex;\r\n  flex-direction: column;\r\n  justify-content: center;\r\n  align-items: center;\r\n  text-align: center;\r\n  padding: 1.15rem 1rem;\r\n  z-index: 2;\r\n  transition: background 0.3s ease;\r\n}\r\n\r\n.gallery-image-card:hover .gallery-image-card__overlay {\r\n  background: linear-gradient(to bottom,\r\n      rgba(0, 0, 0, 0.2) 0%,\r\n      rgba(0, 0, 0, 0.48) 50%,\r\n      rgba(0, 0, 0, 0.76) 100%);\r\n}\r\n\r\n.gallery-image-card__content {\r\n  display: flex;\r\n  flex-direction: column;\r\n  align-items: center;\r\n  text-align: center;\r\n  justify-content: center;\r\n  width: 100%;\r\n  transform: translateY(0);\r\n  transition: transform 0.3s ease;\r\n}\r\n\r\n.gallery-image-card:hover .gallery-image-card__content {\r\n  transform: translateY(-2px);\r\n}\r\n\r\n/* Category Badge hidden for clean centered title aesthetic */\r\n.gallery-image-card__category {\r\n  display: none;\r\n}\r\n\r\n/* Centered Bold White Title Over Image (Matching Mobile View) */\r\n.gallery-image-card__title {\r\n  margin: 0;\r\n  color: #ffffff;\r\n  font-size: clamp(1.05rem, 1.4vw, 1.25rem);\r\n  font-weight: 700;\r\n  line-height: 1.22;\r\n  text-align: center;\r\n  letter-spacing: -0.01em;\r\n  max-width: 95%;\r\n  text-shadow: 0 2px 8px rgba(0, 0, 0, 0.8);\r\n  word-break: break-word;\r\n}\r\n\r\n/* Silent Navigation Hit Zones */\r\n.gallery-image-card__hit-zone {\r\n  position: absolute;\r\n  top: 0;\r\n  bottom: 0;\r\n  width: 30%;\r\n  z-index: 3;\r\n  cursor: pointer;\r\n}\r\n\r\n.gallery-image-card__hit-zone--prev {\r\n  left: 0;\r\n}\r\n\r\n.gallery-image-card__hit-zone--next {\r\n  right: 0;\r\n}\r\n\r\n/* ==========================================================================\r\n   MOBILE GALLERY: EXACT 2-COLUMN STAGGERED MASONRY (< 768px / 375px–480px)\r\n   ========================================================================== */\r\n@media (max-width: 48rem) {\r\n  .gallery-container {\r\n    padding: 0 1rem;\r\n  }\r\n\r\n  .gallery-section-header {\r\n    margin-bottom: 0.85rem;\r\n  }\r\n\r\n  .gallery-filters {\r\n    flex-wrap: nowrap;\r\n    overflow-x: auto;\r\n    -webkit-overflow-scrolling: touch;\r\n    scrollbar-width: none;\r\n    -ms-overflow-style: none;\r\n    gap: 0.4rem;\r\n    margin-top: 0.65rem;\r\n    padding-bottom: 0.25rem;\r\n    width: 100%;\r\n    max-width: 100%;\r\n    box-sizing: border-box;\r\n  }\r\n\r\n  .gallery-filters::-webkit-scrollbar {\r\n    display: none;\r\n  }\r\n\r\n  .gallery-filter-pill {\r\n    padding: 0.45rem 1rem;\r\n    font-size: 0.84rem;\r\n    flex-shrink: 0;\r\n  }\r\n\r\n  /* True 2-Column Staggered Masonry Layout */\r\n  .gallery-grid {\r\n    display: block;\r\n    columns: 2;\r\n    column-gap: 12px;\r\n    width: 100%;\r\n  }\r\n\r\n  .gallery-image-card {\r\n    display: block;\r\n    break-inside: avoid;\r\n    margin-bottom: 12px;\r\n    border-radius: 14px;\r\n    max-height: none;\r\n    box-shadow: 0 4px 14px -3px rgba(15, 23, 42, 0.12);\r\n  }\r\n\r\n  /* Staggered Heights Rhythm */\r\n  .gallery-image-card--short {\r\n    aspect-ratio: 4 / 4.9;\r\n    min-height: 150px;\r\n  }\r\n\r\n  .gallery-image-card--tall {\r\n    aspect-ratio: 4 / 6.4;\r\n    min-height: 210px;\r\n  }\r\n\r\n  /* Centered Overlay & Typography Matching Reference */\r\n  .gallery-image-card__overlay {\r\n    justify-content: center;\r\n    align-items: center;\r\n    text-align: center;\r\n    padding: 0.65rem 0.5rem;\r\n    background: linear-gradient(to bottom,\r\n        rgba(0, 0, 0, 0.12) 0%,\r\n        rgba(0, 0, 0, 0.38) 50%,\r\n        rgba(0, 0, 0, 0.62) 100%);\r\n  }\r\n\r\n  .gallery-image-card__content {\r\n    align-items: center;\r\n    text-align: center;\r\n    justify-content: center;\r\n    width: 100%;\r\n  }\r\n\r\n  /* Omit category badge on mobile card so title is clean and centered */\r\n  .gallery-image-card__category {\r\n    display: none;\r\n  }\r\n\r\n  /* Clean Centered White Title */\r\n  .gallery-image-card__title {\r\n    font-size: clamp(0.82rem, 3.3vw, 0.98rem);\r\n    font-weight: 700;\r\n    text-align: center;\r\n    line-height: 1.2;\r\n    max-width: 95%;\r\n    text-shadow: 0 2px 6px rgba(0, 0, 0, 0.75);\r\n  }\r\n}\r\n\r\n@media (max-width: 25rem) {\r\n  .gallery-grid {\r\n    column-gap: 10px;\r\n  }\r\n\r\n  .gallery-image-card {\r\n    margin-bottom: 10px;\r\n  }\r\n\r\n  .gallery-image-card--short {\r\n    min-height: 135px;\r\n  }\r\n\r\n  .gallery-image-card--tall {\r\n    min-height: 185px;\r\n  }\r\n}\r\n\r\n/* Lightbox Modal */\r\n.lightbox-overlay {\r\n  position: fixed;\r\n  inset: 0;\r\n  z-index: 100;\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n  padding: 1rem;\r\n}\r\n\r\n.lightbox-backdrop {\r\n  position: fixed;\r\n  inset: 0;\r\n  background-color: rgba(10, 15, 29, 0.95);\r\n  backdrop-filter: blur(8px);\r\n}\r\n\r\n.lightbox-container {\r\n  position: relative;\r\n  z-index: 2;\r\n  width: min(100%, 64rem);\r\n  max-height: 90vh;\r\n  display: flex;\r\n  flex-direction: column;\r\n  align-items: center;\r\n  justify-content: center;\r\n}\r\n\r\n.lightbox-viewport {\r\n  width: 100%;\r\n  max-height: 82vh;\r\n  overflow-x: auto;\r\n  overflow-y: hidden;\r\n  scroll-snap-type: x mandatory;\r\n  -webkit-overflow-scrolling: touch;\r\n  scrollbar-width: none;\r\n  display: flex;\r\n  align-items: center;\r\n  will-change: scroll-position;\r\n  transform: translateZ(0);\r\n}\r\n\r\n.lightbox-viewport::-webkit-scrollbar {\r\n  display: none;\r\n}\r\n\r\n.lightbox-track {\r\n  display: flex;\r\n  width: 100%;\r\n  height: 100%;\r\n  transform: translateZ(0);\r\n}\r\n\r\n.lightbox-slide {\r\n  min-width: 100%;\r\n  max-width: 100%;\r\n  flex-shrink: 0;\r\n  scroll-snap-align: center;\r\n  scroll-snap-stop: always;\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n  padding: 0 0.5rem;\r\n  transform: translateZ(0);\r\n  -webkit-backface-visibility: hidden;\r\n  backface-visibility: hidden;\r\n}\r\n\r\n.lightbox-media-wrapper {\r\n  position: relative;\r\n  max-height: 80vh;\r\n  max-width: 100%;\r\n  border-radius: var(--radius-lg);\r\n  overflow: hidden;\r\n  box-shadow: 0 20px 40px -10px rgba(0, 0, 0, 0.5);\r\n  background-color: #000000;\r\n  transform: translateZ(0);\r\n  -webkit-backface-visibility: hidden;\r\n  backface-visibility: hidden;\r\n}\r\n\r\n.lightbox-image {\r\n  max-height: 80vh;\r\n  max-width: 100%;\r\n  width: auto;\r\n  height: auto;\r\n  object-fit: contain;\r\n  display: block;\r\n  user-select: none;\r\n  -webkit-user-drag: none;\r\n  transform: translateZ(0);\r\n  -webkit-backface-visibility: hidden;\r\n  backface-visibility: hidden;\r\n  will-change: transform;\r\n}\r\n\r\n.lightbox-btn {\r\n  display: grid;\r\n  place-items: center;\r\n  background-color: rgba(255, 255, 255, 0.15);\r\n  color: #ffffff;\r\n  border-radius: var(--radius-pill);\r\n  cursor: pointer;\r\n  border: 1px solid rgba(255, 255, 255, 0.25);\r\n  backdrop-filter: blur(6px);\r\n  transition: all var(--transition-fast);\r\n  z-index: 10;\r\n}\r\n\r\n.lightbox-btn:hover {\r\n  background-color: var(--color-primary-500);\r\n  border-color: var(--color-primary-500);\r\n  transform: scale(1.08);\r\n}\r\n\r\n.lightbox-btn--close {\r\n  position: fixed;\r\n  top: 1.25rem;\r\n  right: 1.25rem;\r\n  width: 2.75rem;\r\n  height: 2.75rem;\r\n  z-index: 105;\r\n}\r\n\r\n.lightbox-btn--nav {\r\n  position: fixed;\r\