  .page-hero,\r\n  .contact-hero,\r\n  .courses-hero {\r\n    padding: clamp(1.5rem, 5.5vw, 2.25rem) 0 !important;\r\n    text-align: center;\r\n  }\r\n\r\n  .page-hero .container,\r\n  .contact-hero .container {\r\n    display: flex;\r\n    flex-direction: column;\r\n    align-items: center;\r\n  }\r\n\r\n  /* ==========================================================================\r\n     UNIFIED SUBPAGE HERO CARDS ON MOBILE (About, Colleges, Services, Gallery, Contact)\r\n     ========================================================================== */\r\n  .about-page .page-hero,\r\n  .colleges-page .page-hero,\r\n  .services-page .page-hero,\r\n  .gallery-page .page-hero,\r\n  .contact-page .page-hero,\r\n  .page-hero {\r\n    background-position: 75% center !important;\r\n    padding: clamp(1.85rem, 5.5vw, 2.5rem) 0 !important;\r\n    text-align: left !important;\r\n  }\r\n\r\n  .about-page .page-hero::before,\r\n  .colleges-page .page-hero::before,\r\n  .services-page .page-hero::before,\r\n  .gallery-page .page-hero::before,\r\n  .contact-page .page-hero::before,\r\n  .page-hero::before {\r\n    background: linear-gradient(\r\n      180deg,\r\n      rgba(8, 28, 76, 0.90) 0%,\r\n      rgba(10, 36, 95, 0.82) 45%,\r\n      rgba(7, 22, 60, 0.75) 100%\r\n    ) !important;\r\n    backdrop-filter: blur(1px) !important;\r\n  }\r\n\r\n  .about-hero__container,\r\n  .colleges-hero__container,\r\n  .services-hero__container,\r\n  .gallery-hero__container,\r\n  .contact-hero__container,\r\n  .page-hero .container {\r\n    width: 100% !important;\r\n    max-width: 100% !important;\r\n    display: flex !important;\r\n    flex-direction: column !important;\r\n    align-items: flex-start !important;\r\n    text-align: left !important;\r\n  }\r\n\r\n  .about-hero__eyebrow,\r\n  .colleges-hero__eyebrow,\r\n  .services-hero__eyebrow,\r\n  .gallery-hero__eyebrow,\r\n  .contact-hero__eyebrow {\r\n    font-size: 0.72rem !important;\r\n    margin-bottom: 0.45rem !important;\r\n